{
  "manifest_version": 3,
  "name": "UniFLOW DevTool",
  "version": "0.3.0",
  "description": "UniFLOW 화면 컨텍스트 추출 + 접근경로 녹화 도구",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js", "src/content/userSwitch.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon_16x16.png",
    "48": "icons/icon_48x48.png",
    "128": "icons/icon_128x128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "UniFLOW DevTool",
    "default_icon": {
      "16": "icons/icon_16x16.png",
      "48": "icons/icon_48x48.png",
      "128": "icons/icon_128x128.png"
    }
  }
}
